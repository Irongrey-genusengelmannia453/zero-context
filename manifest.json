{
    "manifest_version": 3,
    "name": "ZeroContext - Local PII Redactor",
    "version": "1.0.0",
    "description": "Client-side, zero-latency Data Loss Prevention (DLP) for AI interfaces.",
    "permissions": [
        "activeTab",
        "clipboardRead",
        "clipboardWrite",
        "storage",
        "offscreen"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
        "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:;"
    },
    "sandbox": {
        "pages": [
            "src/sandbox/sandbox.html"
        ]
    },
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "ZeroContext"
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*"
            ],
            "js": [
                "src/content.ts"
            ]
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*"
            ],
            "js": [
                "src/injected.ts"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ]
}