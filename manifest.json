{
    "manifest_version": 3,
    "name": "ZeroContext",
    "version": "1.0.0",
    "description": "Use AI without the privacy risk. Automatically mask sensitive data entirely in your browser before it ever hits the cloud.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "clipboardRead",
        "clipboardWrite",
        "storage",
        "offscreen",
        "scripting",
        "alarms",
        "unlimitedStorage"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
        "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:;"
    },
    "sandbox": {
        "pages": [
            "src/sandbox/sandbox.html"
        ]
    },
    "host_permissions": [
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*",
        "*://*.perplexity.ai/*",
        "*://chat.deepseek.com/*"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "ZeroContext",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.chatgpt.com/*",
                "*://*.claude.ai/*",
                "*://*.gemini.google.com/*",
                "*://*.perplexity.ai/*",
                "*://chat.deepseek.com/*"
            ],
            "js": [
                "src/content.ts"
            ]
        },
        {
            "matches": [
                "*://*.chatgpt.com/*",
                "*://*.claude.ai/*",
                "*://*.gemini.google.com/*",
                "*://*.perplexity.ai/*",
                "*://chat.deepseek.com/*"
            ],
            "js": [
                "src/injected.ts"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ]
}